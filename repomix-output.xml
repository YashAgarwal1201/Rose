<file path="vite.config.ts">
import { readFileSync } from "node:fs";
import { fileURLToPath, URL } from "node:url";
import { defineConfig, type Plugin } from "vite";
import vue from "@vitejs/plugin-vue";
import tailwindcss from "@tailwindcss/vite";

function getBuildVersion() {
  const now = new Date();
  const day = String(now.getDate()).padStart(2, "0");
  const month = String(now.getMonth() + 1).padStart(2, "0");
  const year = now.getFullYear();
  return `v0.${day}.${month}.${year}`;
}

// Injects the emitted asset list into public/sw.js at build time.
// Only runs on `vite build`; never touches dev server behavior.
function swManifestPlugin(): Plugin {
  return {
    name: "sw-manifest",
    apply: "build",
    generateBundle(_, bundle) {
      const assets = Object.keys(bundle)
        .filter((name) => !name.endsWith(".map"))
        .map((name) => `/${name}`);
      const precacheList = JSON.stringify(["/", "/index.html", ...assets]);

      const swChunk = bundle["sw.js"] as { code?: string } | undefined;
      if (swChunk?.code) {
        swChunk.code = swChunk.code.replace("__PRECACHE_MANIFEST__", precacheList);
      }
    },
  };
}

export default defineConfig(({ command }) => {
  const isDev = command === "serve";

  return {
    plugins: [vue(), tailwindcss(), swManifestPlugin()],
    define: {
      __APP_VERSION__: JSON.stringify(getBuildVersion()),
    },
    server: {
      port: 5176,
      ...(isDev && {
        https: {
          key: readFileSync("certs/localhost-key.pem"),
          cert: readFileSync("certs/localhost.pem"),
        },
      }),
    },
    resolve: {
      alias: {
        "@": fileURLToPath(new URL("./src", import.meta.url)),
      },
    },
  };
});
</file>

