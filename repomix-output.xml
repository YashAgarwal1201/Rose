    </template>

    <!-- Larger screens: full trail -->
    <template v-for="(crumb, index) in crumbs" :key="crumb.id ?? 'root'">
      <div class="hidden sm:flex items-center gap-0.5">
        <ChevronRightIcon class="w-3.5 h-3.5 text-rose-text-muted/50 shrink-0" />
