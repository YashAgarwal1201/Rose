import { defineStore } from "pinia";
import { ref } from "vue";
import db from "../db";
import type { Folder, FeatureType } from "../db/types";
import { useTodosStore } from "./todos";

export const useFoldersStore = defineStore("folders", () => {
  const folders = ref<Folder[]>([]);

  async function loadFolders(type: FeatureType) {
    folders.value = await db.folders.where("type").equals(type).toArray();
  }

  // async function createFolder(name: string, parentId: string | null, type: FeatureType) {
  //   const now = Date.now();
  //   const folder: Folder = {
  //     id: crypto.randomUUID(),
  //     name,
  //     parentId,
  //     type,
  //     createdAt: now,
  //     updatedAt: now,
  //   };
  //   await db.folders.add(folder);
  //   await loadFolders(type);
  //   return folder.id;
  // }

  // async function renameFolder(id: string, name: string) {
  //   await db.folders.update(id, { name, updatedAt: Date.now() });
  //   const updated = folders.value.find((f) => f.id === id);
  //   if (updated) await loadFolders(updated.type);
  // }

  async function createFolder(name: string, parentId: string | null, type: FeatureType) {
    const trimmed = name.trim();
    const duplicate = folders.value.find(
      (f) =>
        f.parentId === parentId &&
        f.type === type &&
        f.name.toLowerCase() === trimmed.toLowerCase(),
    );
    if (duplicate) {
      throw new Error(`A folder named "${trimmed}" already exists here.`);
    }
    const now = Date.now();
    const folder: Folder = {
      id: crypto.randomUUID(),
      name: trimmed,
      parentId,
      type,
      createdAt: now,
      updatedAt: now,
    };
    await db.folders.add(folder);
    await loadFolders(type);
    return folder.id;
  }

  async function renameFolder(id: string, name: string) {
    const trimmed = name.trim();
    const target = folders.value.find((f) => f.id === id);
    if (!target) return;
    const duplicate = folders.value.find(
      (f) =>
        f.id !== id &&
        f.parentId === target.parentId &&
        f.type === target.type &&
        f.name.toLowerCase() === trimmed.toLowerCase(),
    );
    if (duplicate) {
      throw new Error(`A folder named "${trimmed}" already exists here.`);
    }
    await db.folders.update(id, { name: trimmed, updatedAt: Date.now() });
    await loadFolders(target.type);
  }

  async function deleteFolder(id: string) {
    const target = folders.value.find((f) => f.id === id);
    if (!target) return;
    const descendants = folders.value.filter((f) => f.parentId === id);
    for (const child of descendants) {
      await deleteFolder(child.id);
    }
    if (target.type === "todo") {
      const todosStore = useTodosStore();
      await todosStore.deleteTodoListsByFolder(target.id);
    }
    await db.folders.delete(id);
    await loadFolders(target.type);
  }

  async function moveFolder(id: string, newParentId: string | null) {
    await db.folders.update(id, { parentId: newParentId, updatedAt: Date.now() });
    const target = folders.value.find((f) => f.id === id);
    if (target) await loadFolders(target.type);
  }

  return { folders, loadFolders, createFolder, renameFolder, deleteFolder, moveFolder };
});
