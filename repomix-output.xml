// src/composables/useExplorerViewMode.ts
import { ref, watch } from "vue";

export type ViewMode = "grid" | "list";
export type SortKey = "name" | "updatedAt";
export type SortDir = "asc" | "desc";

const VIEW_MODE_KEY = "rose-explorer-view-mode";
const SORT_KEY_KEY = "rose-explorer-sort-key";
const SORT_DIR_KEY = "rose-explorer-sort-dir";

const viewMode = ref<ViewMode>((localStorage.getItem(VIEW_MODE_KEY) as ViewMode) || "grid");
const sortKey = ref<SortKey>((localStorage.getItem(SORT_KEY_KEY) as SortKey) || "name");
const sortDir = ref<SortDir>((localStorage.getItem(SORT_DIR_KEY) as SortDir) || "asc");

watch(viewMode, (v) => localStorage.setItem(VIEW_MODE_KEY, v));
watch(sortKey, (v) => localStorage.setItem(SORT_KEY_KEY, v));
watch(sortDir, (v) => localStorage.setItem(SORT_DIR_KEY, v));

export function useExplorerViewMode() {
  function toggleViewMode() {
    viewMode.value = viewMode.value === "grid" ? "list" : "grid";
  }

  function setSortKey(key: SortKey) {
    if (sortKey.value === key) {
      sortDir.value = sortDir.value === "asc" ? "desc" : "asc";
    } else {
      sortKey.value = key;
      sortDir.value = "asc";
    }
  }

  return { viewMode, sortKey, sortDir, toggleViewMode, setSortKey };
}
